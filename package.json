{
  "name": "qemu-debug",
  "displayName": "qemu-debug",
  "description": "QEMU Cortex-M3 debugging for mps2-an385",
  "version": "0.1.1",
  "publisher": "harikalyan",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/hari-sh/qemu-debug.git"
  },
  "engines": {
    "vscode": ">=1.85.0"
  },
  "categories": [
    "Debuggers"
  ],
  "activationEvents": [
    "onDebug",
    "onView:qemu-m3.memoryView",
    "onView:qemu-m3.registersView"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "debuggers": [
      {
        "type": "qemu-m3",
        "label": "QEMU Cortex-M3",
        "languages": [
          "c",
          "cpp",
          "assembly"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "type",
              "request",
              "name",
              "elfFile"
            ],
            "properties": {
              "type": {
                "type": "string"
              },
              "request": {
                "type": "string",
                "enum": [
                  "launch"
                ]
              },
              "name": {
                "type": "string"
              },
              "elfFile": {
                "type": "string"
              },
              "qemuPath": {
                "type": "string"
              },
              "gdbPath": {
                "type": "string"
              },
              "gdbPort": {
                "type": "number"
              },
              "machine": {
                "type": "string"
              },
              "buildCommand": {
                "type": "string"
              },
              "ledRegister": {
                "type": "string"
              },
              "stopOnEntry": {
                "type": "boolean"
              }
            }
          },
          "attach": {
            "required": [
              "type",
              "request",
              "name"
            ],
            "properties": {
              "type": {
                "type": "string"
              },
              "request": {
                "type": "string",
                "enum": [
                  "attach"
                ]
              },
              "name": {
                "type": "string"
              },
              "elfFile": {
                "type": "string"
              },
              "gdbPath": {
                "type": "string"
              },
              "gdbPort": {
                "type": "number"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "qemu-m3",
            "request": "launch",
            "name": "Debug Firmware",
            "elfFile": "${workspaceFolder}/build/firmware.elf",
            "qemuPath": "/usr/bin/qemu-system-arm",
            "gdbPath": "/usr/bin/arm-none-eabi-gdb",
            "gdbPort": 3333,
            "machine": "mps2-an385",
            "buildCommand": "make -C ${workspaceFolder}",
            "ledRegister": "0x40028000"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "qemu-m3.refreshViews",
        "title": "Refresh",
        "icon": "$(refresh)"
      }
    ],
    "views": {
      "debug": [
        {
          "id": "qemu-m3.registersView",
          "name": "Registers",
          "type": "webview"
        },
        {
          "id": "qemu-m3.memoryView",
          "name": "Memory",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "qemu-m3.refreshViews",
          "when": "view == qemu-m3.memoryView || view == qemu-m3.registersView",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm test",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "test": "npx tsc --noEmit && npm run compile",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "tree-kill": "^1.2.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}