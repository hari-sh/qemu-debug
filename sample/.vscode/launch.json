{
  "version": "0.2.0",
  "configurations": [{
    "type": "qemu-m3", "request": "launch", "name": "Debug Firmware",
    "elfFile": "${workspaceFolder}/build/firmware.elf",
    "qemuPath": "/usr/bin/qemu-system-arm", "gdbPath": "/usr/bin/arm-none-eabi-gdb",
    "gdbPort": 3333, "machine": "mps2-an385",
    "buildCommand": "make -C ${workspaceFolder}", "ledRegister": "0x40028000"
  }]
}
