{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "qemu-m3",
      "request": "launch",
      "name": "Debug Firmware",
      "elfFile": "${workspaceFolder}/${make:TARGET}",
      "qemuPath": "${make:QEMU}",
      "gdbPath": "${make:GDB}",
      "gdbPort": 3333,
      "machine": "${make:QEMU_MACH}",
      "buildCommand": "make -C ${workspaceFolder}",
      "ledRegister": "${make:LED_ADDR}",
      "disassembly": true
    }
  ]
}
